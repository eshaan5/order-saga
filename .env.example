# REFERENCE — every environment variable the system reads, with its default.
#
# You do NOT need to create a .env file. Every value below is already the
# built-in default, and they match docker-compose.yml, so a fresh clone runs
# with no configuration at all.
#
# To override one, export it or prefix the command:
#
#   LEASE_TTL_MS=10000 npm run dev:coordinator
#   COORDINATOR_PORT=3010 npm run dev:coordinator     # second instance
#
# Nothing in the code loads a .env file — configuration comes from the process
# environment, which is what a container or a process manager provides.

# ---- MySQL -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=saga
DB_PASSWORD=saga
DB_POOL_SIZE=10

# ---- Redis (cache only; MySQL is always the source of truth) ---------------
REDIS_URL=redis://127.0.0.1:6379

# ---- Service ports ---------------------------------------------------------
COORDINATOR_PORT=3000
ORDER_PORT=3001
INVENTORY_PORT=3002
PAYMENT_PORT=3003
SHIPPING_PORT=3004
NOTIFICATION_PORT=3005

# ---- Service URLs (how the coordinator reaches each worker) ----------------
ORDER_URL=http://127.0.0.1:3001
INVENTORY_URL=http://127.0.0.1:3002
PAYMENT_URL=http://127.0.0.1:3003
SHIPPING_URL=http://127.0.0.1:3004

# ---- Saga tuning -----------------------------------------------------------
# Requirement 4: "each step has a time limit; if it runs longer, treat it as failed"
STEP_TIMEOUT_MS=3000
# "try it a few more times (with a short wait between tries) before giving up"
STEP_MAX_ATTEMPTS=3
STEP_BASE_DELAY_MS=100
STEP_MAX_DELAY_MS=2000

# How many orders one coordinator instance claims per poll, and how many it
# runs concurrently. Batch size is a constant so memory stays flat regardless
# of how large the order file gets.
CLAIM_BATCH_SIZE=50
ORDER_CONCURRENCY=25
POLL_INTERVAL_MS=500

# Lease held on a claimed order. A crashed coordinator stops renewing, the
# lease goes stale, and another instance picks the order back up.
LEASE_TTL_MS=60000
LEASE_HEARTBEAT_MS=20000

# CSV ingestion: rows buffered before one multi-row INSERT IGNORE.
# A constant, NOT the file size — this value IS the memory ceiling.
INGEST_BATCH_SIZE=500

# ---- Notification service --------------------------------------------------
# Where the notification service reads shipped orders from. It talks HTTP to
# the coordinator rather than reading the `saga` schema — the schema boundary
# is what "each service keeps its own data" actually means.
COORDINATOR_URL=http://127.0.0.1:3000
# Assignment says every 15 minutes. Lower it (e.g. */1) to watch it work.
NOTIFICATION_CRON=*/15 * * * *
NOTIFICATION_BATCH_SIZE=100
# A CLAIMED row older than this is assumed abandoned and gets reclaimed.
NOTIFICATION_STALE_MS=120000

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=info
